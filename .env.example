# Browser-safe Supabase settings (anon key is designed to be public; protect with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Browser-exposed only if you intentionally use the public Drive API.
# Prefer the server-side /api/drive proxy in production.
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_FOLDER_ID=

# Vercel/server-only settings — NEVER prefix these with VITE_
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EVENT_UNLOCK_SECRET=
GOOGLE_DRIVE_API_KEY=

# Local development note:
# `npm run dev` now serves the /api/*.js handlers through Vite automatically.
# The service-role key and EVENT_UNLOCK_SECRET are required for the private event lock.
